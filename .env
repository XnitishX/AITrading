# ── LLM Model Settings ───────────────────────────────────────────────
# Model ID for WatsonX — must be a chat-capable model from the supported list.
# Recommended: meta-llama/llama-3-3-70b-instruct (powerful, good for agents)
# Alternatives: mistralai/mistral-small-3-1-24b-instruct-2503, meta-llama/llama-4-maverick-17b-128e-instruct-fp8
WATSONX_MODEL_ID=meta-llama/llama-3-3-70b-instruct

# Optional: set to "false" to disable LLM and use rule-based copilot only
LLM_ENABLED=true
